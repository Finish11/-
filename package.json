{
  "name": "pulsenet",
  "private": true,
  "version": "1.3.6",
  "type": "module",
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:seed": "tsx scripts/seed-db.ts",
    "build:demo": "VITE_DEMO=1 vite build --config vite.demo.config.ts && cp demo-dist/demo.html demo-standalone.html",
    "android:assets": "node scripts/android-assets.mjs",
    "android:sync": "npm run build:demo && npm run android:assets && cap sync android",
    "android:add": "cap add android",
    "apk:debug": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "android:open": "cap open android",
    "preview:demo": "npx --yes serve . -l 4173"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/network": "^8.0.1",
    "better-sqlite3": "^11.5.0",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.1",
    "lucide-react": "^0.460.0",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.25",
    "@types/node": "^20.17.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-singlefile": "^2.3.4"
  },
  "description": "ПульсСети — проверка белых списков, шатдаунов и мониторинг VPN (RU)",
  "engines": {
    "node": ">=20"
  }
}
