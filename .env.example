# Скопируйте в .env и заполните при необходимости.
# В коде переменные читаются через process.env, значения ниже — дефолты.

# Порт HTTP-сервера (по умолчанию 3000)
PORT=3000

# production — раздавать собранный dist/ (npm run build), иначе Vite в middleware-режиме
NODE_ENV=development

# Каталог с SQLite-базой. По умолчанию ./data внутри проекта.
# На PaaS с эфемерным диском смонтируйте постоянный том и укажите его здесь.
DATA_DIR=./data

# Необязательно: общий HTTPS API отчётов для web/APK на этапе сборки.
# В GitHub Actions используется repository variable PULSENET_COMMUNITY_API_URL.
# VITE_COMMUNITY_API_URL=https://pulsenet-api.example.com
