{
  "name": "pulsenet",
  "private": true,
  "version": "1.8.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:core": "tsx --test tests/core.test.ts",
    "db:seed": "tsx scripts/seed-db.ts",
    "build:demo": "VITE_DEMO=1 vite build --config vite.demo.config.ts && cp demo-dist/demo.html demo-standalone.html",
    "android:assets": "node scripts/android-assets.mjs",
    "android:sync": "npm run build:demo && npm run android:assets && cap sync android",
    "android:add": "cap add android",
    "apk:debug": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "android:open": "cap open android",
    "preview:demo": "npx --yes serve . -l 4173",
    "typecheck:community": "tsc --noEmit -p community/tsconfig.json",
    "test:worker": "tsx --test tests/community-worker.test.ts",
    "test:regressions": "tsx --test tests/regressions.test.ts",
    "test:sync": "tsx --test tests/sync-hardening.test.ts tests/community-quota.test.ts",
    "test:native": "tsx --test tests/native-contract.test.ts",
    "test:speed": "tsx --test tests/speed-test.test.ts tests/speed-endpoints.test.ts tests/speed-runner.test.ts tests/speed-payload.test.ts",
    "test:routes": "tsx --test tests/routes-and-sharing.test.ts",
    "test:scan": "tsx --test tests/scan-budget.test.ts tests/ui-batch.test.ts tests/app-settings.test.ts",
    "test:e2e": "playwright test",
    "deploy:community": "node scripts/deploy-community.mjs",
    "test:version": "tsx --test tests/version.test.ts tests/version-bump.test.ts tests/app-update.test.ts",
    "version:android": "node scripts/app-version.mjs",
    "version:bump": "node scripts/version-bump.mjs",
    "version:guard": "node scripts/version-guard.mjs",
    "release:notes": "node scripts/release-notes.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "better-sqlite3": "^11.5.0",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.1",
    "lucide-react": "^0.460.0",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@cloudflare/workers-types": "5.20260730.1",
    "@playwright/test": "1.65.0",
    "@sparticuz/chromium": "153.0.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.25",
    "@types/node": "^20.17.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "esbuild": "0.25.12",
    "miniflare": "4.20260730.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^6.4.4",
    "vite-plugin-singlefile": "^2.3.4",
    "wrangler": "4.116.0"
  },
  "description": "ПульсСети — проверка белых списков, шатдаунов и мониторинг VPN (RU)",
  "engines": {
    "node": ">=20"
  }
}
